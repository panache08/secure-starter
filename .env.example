# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. NEVER commit the filled-in file.
# ---------------------------------------------------------------------------

# Supabase — the URL and ANON key are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. BYPASSES Row Level Security. Never prefix with NEXT_PUBLIC_.
# Only read this in server code, and only after your own authz checks.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Upstash Redis — required for real rate limiting on serverless.
UPSTASH_REDIS_REST_URL=https://YOUR-DB.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Secret used to verify inbound webhooks (payments, etc.). Server-only.
WEBHOOK_SIGNING_SECRET=whsec_replace_me
